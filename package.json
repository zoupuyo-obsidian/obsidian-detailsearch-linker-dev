{
  "name": "obsidian-detailsearch-linker-dev",
  "version": "1.0.6-beta.1",
  "description": "Search vault note bodies on demand for a selected term and insert heading links in the configured internal-link format.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node scripts/run-tests.mjs",
    "lint": "eslint .",
    "verify:release": "node scripts/verify-release.mjs",
    "check": "npm test && npm run lint && npm run build && npm run verify:release"
  },
  "keywords": [],
  "license": "0-BSD",
  "devDependencies": {
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@eslint/js": "^9.39.4",
    "@types/node": "^22.15.17",
    "esbuild": "0.25.5",
    "eslint": "^9.39.4",
    "eslint-plugin-obsidianmd": "^0.3.0",
    "globals": "^17.6.0",
    "jiti": "^2.6.1",
    "obsidian": "^1.13.1",
    "tsx": "^4.20.5",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.59.1"
  }
}
